# Copy to .env and fill in before: docker compose up

SHEET_ID=your_google_sheet_id
SHEET_NAME=2026

# Inside Docker this path is overridden by docker-compose; keep for local dev.
GOOGLE_APPLICATION_CREDENTIALS=./credentials.json

PORT=3001

# Random string used to sign login tokens. Required. Generate with:
#   node -p "require('crypto').randomBytes(32).toString('hex')"
JWT_SECRET=change_me_to_a_long_random_string

# Optional. If set, only this email may register (first boot) or log in.
# AUTH_EMAIL=you@example.com
